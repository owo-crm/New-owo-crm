# Скопируй в .env.local и заполни. Никогда не коммить .env.local.
# На Railway те же переменные задаются в Service → Variables.

# ── База (Railway: ${{Postgres.DATABASE_URL}}) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/owo
# true, если провайдер требует SSL без своего сертификата (внутренняя сеть Railway — не нужно)
DATABASE_SSL=
DATABASE_POOL_SIZE=10

# ── Приложение ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=OWO CRM
# Открытая регистрация (по умолчанию закрыта: аккаунты создаём скриптом user:create)
REGISTRATION_OPEN=

# ── Приём заявок с сайта: случайная строка (openssl rand -hex 32) ──
INTAKE_IP_SALT=

# ── Уведомления (выключены, пока не true) ──
OUTBOUND_NOTIFICATIONS_ENABLED=
# off — выключить фоновый воркер (по умолчанию работает раз в минуту)
NOTIFICATION_WORKER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@owoads.pl

# E-mail (Resend): уведомления + сброс пароля
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
