# Скопируй в .env.local и заполни. Никогда не коммить .env.local.
# На Railway те же переменные задаются в Service → Variables.

# ── База (Railway: ${{Postgres.DATABASE_URL}}) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/owo
# true, если провайдер требует SSL без своего сертификата (внутренняя сеть Railway — не нужно)
DATABASE_SSL=
DATABASE_POOL_SIZE=10

# ── Приложение ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=OWO CRM
# Открытая регистрация (по умолчанию закрыта: аккаунты создаём скриптом user:create)
REGISTRATION_OPEN=

# ── Приём заявок с сайта: случайная строка (openssl rand -hex 32) ──
INTAKE_IP_SALT=

# ── Уведомления (выключены, пока не true) ──
OUTBOUND_NOTIFICATIONS_ENABLED=
# off — выключить фоновый воркер (по умолчанию работает раз в минуту)
NOTIFICATION_WORKER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@owoads.pl

# E-mail (Resend): уведомления + сброс пароля
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
TRUSTED_IP_HEADER=

# ── Stripe: абонементы CRM (решение 022). Пусто = Stripe выключен, суммы считаются только в базе ──
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → https://<домен>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Ставка VAT 23 % (Products → Tax rates, «exclusive»): бесплатно, для фирм из Польши
STRIPE_TAX_RATE_ID=
# true = Stripe Tax считает налог сам (+0,5 % оборота) — нужно только при продажах за границу
STRIPE_AUTOMATIC_TAX=

# ── Главный админ OWO Ads (решение 023): создаётся/обновляется при каждом запуске, видит все бизнесы ──
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Кабинет агентства: имя бизнеса, который создаётся сам для админов платформы ──
AGENCY_ORG_NAME=OWO Ads
# Логины через запятую, которые удаляются при запуске (их бизнесы переходят ADMIN_LOGIN). По умолчанию test01.
ADMIN_REMOVE_LOGINS=

# Почта фирм (решение 035): ключ шифрования паролей SMTP/ключей Resend, 32 байта base64.
# Создать один раз: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВНИМАНИЕ: если ключ потерять или сменить — сохранённые пароли почты придётся ввести заново.
MAIL_SECRET_KEY=
